{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Optional per-project config. Place at project root as guardian.config.json. All fields are optional — auto-detection is used for anything not specified.",
  "sourceDirectories": ["src"],
  "docsDirectories": ["docs"],
  "excludeDirectories": ["node_modules", "dist", "build", ".next", ".turbo", "coverage", ".venv", "__pycache__", ".pytest_cache", "site-packages", ".mypy_cache", ".ruff_cache"],
  "fileExtensions": [".ts", ".tsx", ".py"],
  "jsdoc": {
    "requiredTags": ["what", "how", "why", "sideeffects", "systemlayer", "domain", "tags"],
    "minTags": 3,
    "minCommentLength": 5
  }
}
